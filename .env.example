APP_ENV=development
# Origens exatas, separadas por vírgula. Nunca usar "*".
CORS_ORIGINS=http://localhost:3000

# --- Banco da trilha de auditoria: Neon (PostgreSQL) ---
# Cole a connection string do console do Neon (botão Connect). O back troca o driver para
# psycopg 3 e conecta sempre com sslmode=verify-full + channel_binding=require.
# Na query só valem sslmode, channel_binding e sslrootcert.
# Crie o projeto na região São Paulo (AWS sa-east-1): fora do Brasil é transferência
# internacional de dados (LGPD art. 33). Use um papel só com INSERT (ver README).
# Vazio = SQLite local em data/app.db (só testes e offline). Em APP_ENV=production é obrigatória.
# Ex.: postgresql://raiz_app:<senha>@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
# Base dos links de cada arquivo do acervo gravados no banco.
ACERVO_REPO_URL=https://github.com/jvictorgp19-rgb/hacka-back/blob/main

# --- Identidade (ver docs/CONTRATO.md) ---
# demo  = simulação de RBAC: aceita personaId do cliente. SÓ com dados sintéticos.
# token = exige Authorization: Bearer <token assinado> (python -m app.core.auth <personaId>)
AUTH_MODE=demo
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_MIN=30
# Persona usada quando o cliente não se identifica (modo demo). Vazio = só nível Pública.
DEMO_DEFAULT_PERSONA=

# --- LLM local na VM (API OpenAI-compatible: vLLM, Ollama, LM Studio) ---
# Vazio = LLM desligado; o chat responde com calculadoras + trechos citados.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Opcional, usado só em sínteses longas. Vazio = usa LLM_MODEL.
LLM_MODEL_LARGE=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=500
# HTTP sem TLS só é aceito para localhost (túnel SSH), salvo se true.
LLM_ALLOW_HTTP=false
LLM_COST_PER_1K_BRL=0

# --- Limites ---
MAX_MESSAGE_CHARS=2000
MAX_BODY_BYTES=16384
RATE_CHAT_PER_MIN=30
RATE_REPORTS_PER_MIN=3
RATE_GRAFO_PER_MIN=30
